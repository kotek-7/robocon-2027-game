{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "robocon-2027-game",
	"main": "cloudflare/worker.js",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	"account_id": "769b391d51df077598b7d91579605fe2",
	// Production is served only on the custom domain.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "robocon2027.kotek7.com", "custom_domain": true }],
	"assets": {
		"directory": "build/cdn",
		"binding": "ASSETS",
		// Only these endpoints need Worker code; serve other assets directly.
		"run_worker_first": ["/ws", "/health", "/index.wasm"],
	},
	"vars": { "GAME_ORIGIN": "https://robocon2027-origin.kotek7.com" },
	// Keep the dormant namespace during cutover; no requests route to it.
	"durable_objects": {
		"bindings": [{ "name": "ARENA", "class_name": "ArenaServer" }],
	},
	"exports": {
		"ArenaServer": { "type": "durable-object", "storage": "sqlite" },
	},
	"observability": { "enabled": true },
}
