{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "robocon-2027-game",
	"main": "cloudflare/worker.js",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	"account_id": "769b391d51df077598b7d91579605fe2",
	// Production is served only on the custom domain.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "robocon2027.kotek7.com", "custom_domain": true }],
	"assets": {
		"directory": "build/cdn",
		"binding": "ASSETS",
		// Only these endpoints need Worker code; serve other assets directly.
		"run_worker_first": ["/ws", "/health", "/index.wasm"]
	},
	"containers": [
		{
			"class_name": "ArenaServer",
			"image": "./Dockerfile",
			// One service image/size with platform-managed rollouts (direct DO API).
			"scheduling_policy": "default",
			"instance_type": "basic",
			// All players share the casual-v2 matchmaking pool.
			"max_instances": 1
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "ARENA", "class_name": "ArenaServer" }]
	},
	// Adopt the existing SQLite namespace without renaming or recreating it.
	"exports": {
		"ArenaServer": { "type": "durable-object", "storage": "sqlite" }
	},
	"observability": { "enabled": true }
}
