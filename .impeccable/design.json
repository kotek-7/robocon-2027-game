	"narrative": {
		"northStar": "Floating toy arena",
		"overview": "A floating competition arena with golden-yellow platforms, vivid red and blue robots, emerald building pads and a cyan environment. Rounded shells and dark faceplates give the machines a friendly toy character while block shapes and the field retain their competitive meaning.\n\nThe arena occupies the viewport. Compact score tiles, a clock and pictorial cargo indicators leave room for driving. Menu labels are short; motion belongs to the robots and objects.",
		"keyCharacteristics": [
			"Distinct robot silhouettes and team pips accompany color.",
			"Fredoka Semibold carries short labels and large numerals.",
			"Soft UI shadows and matte 3D materials give gentle depth."
		],
		"rules": [
			{
				"name": "The Team Identity Rule",
				"body": "Team color is accompanied by one or two pips; TR and BR retain different silhouettes.",
				"section": "colors"
			}
		],
		"dos": [
			"Do preserve the field geometry when changing surface color or lighting.",
			"Do pair team color with pips and role silhouettes.",
			"Do keep shell lean, bounce and squash separate from gameplay position.",
			"Do use short labels and drawn pictograms for immediate actions."
		],
		"donts": [
			"Don't introduce a dashboard or prose panels into the play HUD.",
			"Don't replace block identity or team signals with decorative color.",
			"Don't treat room-code fields as a reusable visual style."
		]
