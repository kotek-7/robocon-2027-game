[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/menu_layout.gd" id="layout"]

[ext_resource type="Theme" path="res://resources/ui/desktop.tres" id="desktop"]

[ext_resource type="Theme" path="res://resources/ui/mobile.tres" id="mobile"]

[ext_resource type="PackedScene" path="res://scenes/ui/roster.tscn" id="roster"]

[node name="RoomLobbyMenu" type="VBoxContainer"]
custom_minimum_size = Vector2(320, 0)
theme = ExtResource("desktop")
script = ExtResource("layout")
desktop_theme = ExtResource("desktop")
mobile_theme = ExtResource("mobile")

[node name="Heading" type="Label" parent="."]
layout_mode = 2
text = "ROOM"
theme_type_variation = "Heading"
horizontal_alignment = 1

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Code" type="Label" parent="Header"]
layout_mode = 2
size_flags_horizontal = 3
text = "------"
horizontal_alignment = 1
theme_type_variation = "Heading"

[node name="Copy" type="Button" parent="Header"]
layout_mode = 2
custom_minimum_size = Vector2(140, 44)
theme_override_font_sizes/font_size = 18
text = "COPY CODE"

[node name="Info" type="Label" parent="."]
layout_mode = 2
text = "WAITING"
theme_type_variation = "BodyText"
horizontal_alignment = 1

[node name="Roster" parent="." instance=ExtResource("roster")]
layout_mode = 2

[node name="Actions" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Start" type="Button" parent="Actions"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(140, 58)
text = "START"
theme_type_variation = &"Accent"
visible = false

[node name="Waiting" type="Label" parent="Actions"]
layout_mode = 2
size_flags_horizontal = 3
text = "WAITING FOR HOST"
theme_type_variation = "BodyText"
horizontal_alignment = 1
visible = false

[node name="Cancel" type="Button" parent="Actions"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(140, 58)
text = "LEAVE"
