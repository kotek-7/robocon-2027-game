[gd_scene format=3]
[ext_resource type="Script" path="res://scripts/match_menu.gd" id="layout"]
[ext_resource type="Theme" path="res://resources/ui/desktop.tres" id="desktop"]
[ext_resource type="Theme" path="res://resources/ui/mobile.tres" id="mobile"]
[ext_resource type="StyleBoxEmpty" path="res://resources/ui/match_panel.tres" id="surface"]
[ext_resource type="PackedScene" path="res://scenes/ui/roster.tscn" id="roster"]
[ext_resource type="Texture2D" path="res://assets/ui/copy.svg" id="copy"]
[ext_resource type="Texture2D" path="res://assets/ui/leave.svg" id="leave"]
[node name="MatchMenu" type="PanelContainer"]
theme = ExtResource("desktop")
theme_override_styles/panel = ExtResource("surface")
script = ExtResource("layout")
desktop_theme = ExtResource("desktop")
mobile_theme = ExtResource("mobile")
[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 24
[node name="Header" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 12
[node name="Copy" type="Button" parent="Content/Header"]
layout_mode = 2
custom_minimum_size = Vector2(44, 44)
icon = ExtResource("copy")
text = "------"
theme_override_font_sizes/font_size = 22
tooltip_text = "Copy code"
[node name="Spacer" type="Control" parent="Content/Header"]
layout_mode = 2
size_flags_horizontal = 3
[node name="Cancel" type="Button" parent="Content/Header"]
layout_mode = 2
custom_minimum_size = Vector2(44, 44)
icon = ExtResource("leave")
tooltip_text = "Leave"
[node name="Roster" parent="Content" instance=ExtResource("roster")]
layout_mode = 2
[node name="Info" type="Label" parent="Content"]
layout_mode = 2
horizontal_alignment = 1
theme_override_font_sizes/font_size = 32
theme_override_colors/font_color = Color(1, 0.98, 0.94, 1)
theme_override_colors/font_outline_color = Color(0.125, 0.141, 0.243, 1)
theme_override_constants/outline_size = 6
visible = false
[node name="Actions" type="CenterContainer" parent="Content"]
layout_mode = 2
[node name="Start" type="Button" parent="Content/Actions"]
layout_mode = 2
custom_minimum_size = Vector2(200, 52)
text = "START"
theme_type_variation = &"Accent"
disabled = true
[node name="Waiting" type="Label" parent="Content/Actions"]
layout_mode = 2
text = "WAITING FOR HOST"
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(1, 0.98, 0.94, 1)
theme_override_colors/font_outline_color = Color(0.125, 0.141, 0.243, 1)
theme_override_constants/outline_size = 6
