[gd_scene format=3]
[ext_resource type="Script" path="res://scripts/match_menu.gd" id="layout"]
[ext_resource type="Theme" path="res://resources/ui/desktop.tres" id="desktop"]
[ext_resource type="Theme" path="res://resources/ui/mobile.tres" id="mobile"]
[ext_resource type="StyleBoxEmpty" path="res://resources/ui/match_panel.tres" id="surface"]
[ext_resource type="PackedScene" path="res://scenes/ui/roster.tscn" id="roster"]
[node name="MatchMenu" type="PanelContainer"]
theme = ExtResource("desktop")
theme_override_styles/panel = ExtResource("surface")
script = ExtResource("layout")
desktop_theme = ExtResource("desktop")
mobile_theme = ExtResource("mobile")
[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 24
[node name="Roster" parent="Content" instance=ExtResource("roster")]
layout_mode = 2
[node name="Info" type="Label" parent="Content"]
layout_mode = 2
horizontal_alignment = 1
theme_override_font_sizes/font_size = 32
theme_override_colors/font_color = Color(1, 0.98, 0.94, 1)
theme_override_colors/font_outline_color = Color(0.125, 0.141, 0.243, 1)
theme_override_constants/outline_size = 6
